# Copy this file to secrets.env and fill in real values. secrets.env is gitignored and is
# loaded by docker-compose (backend service) to send invite emails via Gmail SMTP.
#
# SMTP_USER: a Gmail address with 2-Step Verification enabled.
# SMTP_PASS: an App Password for that account (myaccount.google.com/apppasswords) - NOT the
#            regular account password, which will not work with SMTP.

SMTP_USER=
SMTP_PASS=

# "Sign in with Google" - a Web application OAuth Client ID from Google Cloud Console. Leave blank
# to keep Google Sign-In hidden on the login screen. See README.md for how to create one.
GOOGLE_CLIENT_ID=
